{
  "name": "klag-website",
  "type": "module",
  "version": "0.2.0",
  "private": true,
  "description": "klag.dev — docs and promotional site for Klag, the Kafka consumer lag exporter.",
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro build && node scripts/gen-llms.mjs && node scripts/gen-skills.mjs",
    "preview": "npm run build && wrangler dev",
    "astro": "astro",
    "check": "node scripts/gen-llms.mjs && wrangler types && astro check",
    "gen:llms": "node scripts/gen-llms.mjs",
    "gen:og": "node scripts/gen-og.mjs",
    "test": "node --test scripts/*.test.mjs",
    "cf-typegen": "wrangler types"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.3",
    "@astrojs/starlight": "^0.41.4",
    "astro": "^7.4.0",
    "gray-matter": "^4.0.3",
    "js-yaml": "^4.3.2",
    "sharp": "^0.35.5"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "typescript": "^6.0.3",
    "wrangler": "^4.114.0"
  },
  "overrides": {
    "undici": "^7.29.1",
    "ws": "^8.20.1",
    "esbuild": "^0.28.1",
    "js-yaml": "^4.3.2",
    "nanoid": "^3.3.17",
    "postcss": "^8.5.23",
    "svgo": "^4.1.0",
    "fast-uri": "^3.1.6",
    "sharp": "$sharp",
    "source-map-js": "^1.2.2",
    "postcss-selector-parser": "^7.1.6"
  }
}
